# Non-secret operator configuration for l9-graphite-memory v2.
data_dir: ~/.local/share/l9-memory
state_dir: ~/.local/state/l9-memory
workspace_namespace: l9-workspace
registry_path: null

memory_enabled: true
write_gates_enabled: false
gate_ttl_minutes: 30

# none | http | zep
projection_backend: none
projection_required: false
graphiti_mcp_url: null
zep_api_url: null

# Read-only structural graph intelligence (ADR-086): none | neo4j.
# The reader password comes from L9_MEMORY_GRAPH_NEO4J_PASSWORD, never this file.
graph_intelligence_backend: none
graph_intelligence_required: false
graph_neo4j_uri: null
graph_neo4j_database: neo4j

# Active memory: shared presence, leases, context and awareness (ADR-065..068):
# none | redis. "redis" needs a deployment identity and exactly one ADR-066
# credential source; the credential itself is read at runtime from the named
# environment variable, mounted file, or secret provider, never from this file.
active_memory_backend: none
active_memory_required: false
active_deployment_id: null
active_trust_domain: null
# development | test | staging | production
active_environment: development
# Name of the environment variable holding the Redis URL (not the URL).
active_redis_url_env: null
active_redis_url_file: null
active_redis_password_file: null
active_redis_host: null
active_redis_port: 6379
active_redis_tls: true
active_key_prefix: l9gm:active
active_heartbeat_interval_seconds: 10
active_lease_ttl_seconds: 30

# Remote HTTP is authenticated by default.
http_auth_required: true

# Local CLI/stdio identity. CLI commands derive the active repository namespace.
# Stdio MCP uses these explicit claims when provided; otherwise it resolves its cwd.
local_principal_id: local-operator
local_tenant_id: local
local_organization_id: local
local_workspace_id: local
local_agent_id: l9-memory-cli
local_read_namespaces: []
local_write_namespaces: []
local_promote_namespaces: []
local_is_admin: false

outbox_batch_size: 50
outbox_max_attempts: 8
outbox_base_delay_seconds: 5

default_search_limit: 20
default_token_budget: 1200
log_level: INFO
json_logs: true
