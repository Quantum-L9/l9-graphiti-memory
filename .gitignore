# L9_META
#   l9_schema: 1
#   repo: Quantum-L9/l9-graphiti-memory
#   path: .gitignore
#   layer: repository
#   owner: memory-control-plane
#   status: active
#   version: 2.2.0
#   updated: 2026-07-22

# Python bytecode and native build output
__pycache__/
*.py[cod]
*.so

# Packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Test, type, lint, and coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# Runtime state and canonical local stores
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.state.json
.l9-memory/
validation/wheel-site/
validation/installed-run/
validation/installed-smoke/
validation/dist/

# Credentials and local configuration
.env
.env.*
*.pem
*.key
config/memory.local.yaml
config/auth_tokens.json

# Editors and operating systems
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# L9 governance workspace activation artifacts (machine-local; never commit)
# setup_workspace_symlinks.sh wires this consumer workspace to the
# ~/.cursor-governance SSOT: .cursor-commands/.cursor point at the clone and
# .claude/{skills,rules} are generated managed mirrors (see
# .claude/skills/.l9-managed-skills.json). All are machine-specific symlinks/
# copies that resolve nowhere else, plus per-workspace runtime state.
/.cursor-commands
/.cursor/
.claude/skills/
.claude/rules/
.l9/
memory-bank/
