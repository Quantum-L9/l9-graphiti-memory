# L9_META
#   l9_schema: 1
#   repo: Quantum-L9/l9-graphiti-memory
#   path: .gitignore
#   layer: repository
#   owner: memory-control-plane
#   status: active
#   version: 2.2.0
#   updated: 2026-07-22

# Python bytecode and native build output
__pycache__/
*.py[cod]
*.so

# Packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Test, type, lint, and coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# Runtime state and canonical local stores
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.state.json
.l9-memory/
.l9/memory/
validation/wheel-site/
validation/installed-run/
validation/installed-smoke/
validation/dist/

# Credentials and local configuration
.env
.env.*
*.pem
*.key
config/memory.local.yaml
config/auth_tokens.json

# Editors and operating systems
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Agent session bootstrap — injected into the checkout per session, not
# repository content. .claude/rules is a symlink into the governance clone
# (an absolute machine path) and .claude/skills is a projection of the
# governance skill library, so committing either would duplicate the
# governance SSOT and hardcode a machine path. .mcp.json is environment
# specific. A repo that later wants its own tracked Claude config can
# un-ignore the specific paths it owns.
/.claude/
/.mcp.json
