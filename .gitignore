# L9_META
#   l9_schema: 1
#   repo: Quantum-L9/l9-graphiti-memory
#   path: .gitignore
#   layer: repository
#   owner: memory-control-plane
#   status: active
#   version: 2.2.0
#   updated: 2026-07-22

# Python bytecode and native build output
__pycache__/
*.py[cod]
*.so

# Packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Test, type, lint, and coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# Runtime state and canonical local stores
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.state.json
.l9-memory/
.l9/memory/
# L4 local-autonomy and publish-gate state (machine-local; never repository
# content). `.l9/` is a governed namespace here -- several `.l9/*.json` and
# `.l9/*.yaml` files are meant to be committed -- so only these subtrees are
# ignored, matching l9-meta-injector and l9-ci-core.
.l9/autonomy/
.l9/pr/
validation/wheel-site/
validation/installed-run/
validation/installed-smoke/
validation/dist/

# Credentials and local configuration
.env
.env.*
*.pem
*.key
config/memory.local.yaml
config/auth_tokens.json

# Editors and operating systems
.idea/
.vscode/
*.swp
*.swo
.DS_Store
