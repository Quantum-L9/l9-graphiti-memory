{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "l9.memory.graph-intelligence-request.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation", "namespaces", "limits"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "operation": {
      "enum": [
        "graph.search",
        "graph.semantic_search",
        "graph.traverse",
        "graph.path",
        "graph.neighborhood",
        "graph.structural_similarity",
        "graph.community",
        "graph.centrality",
        "graph.link_prediction",
        "graph.structural_embedding"
      ]
    },
    "namespaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record_id": {"type": "string", "format": "uuid"},
        "entity_uuid": {"type": "string", "format": "uuid"},
        "query": {"type": "string", "minLength": 1, "maxLength": 1000}
      },
      "maxProperties": 1
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record_id": {"type": "string", "format": "uuid"},
        "entity_uuid": {"type": "string", "format": "uuid"},
        "query": {"type": "string", "minLength": 1, "maxLength": 1000}
      },
      "maxProperties": 1
    },
    "relationship_types": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"}
    },
    "direction": {"enum": ["out", "in", "both"]},
    "as_of": {"type": ["string", "null"], "format": "date-time"},
    "recorded_before": {"type": ["string", "null"], "format": "date-time"},
    "algorithm": {"type": ["string", "null"], "maxLength": 100},
    "required": {"type": "boolean", "default": false},
    "profile_ref": {"type": ["string", "null"], "maxLength": 300},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_depth", "max_nodes", "max_edges", "max_paths", "max_runtime_ms"],
      "properties": {
        "max_depth": {"type": "integer", "minimum": 0, "maximum": 6},
        "max_nodes": {"type": "integer", "minimum": 1, "maximum": 1000},
        "max_edges": {"type": "integer", "minimum": 1, "maximum": 5000},
        "max_paths": {"type": "integer", "minimum": 1, "maximum": 100},
        "max_runtime_ms": {"type": "integer", "minimum": 10, "maximum": 30000}
      }
    }
  }
}
