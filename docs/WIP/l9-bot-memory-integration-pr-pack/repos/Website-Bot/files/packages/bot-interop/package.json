{
  "name": "@quantum-l9/bot-interop",
  "version": "1.0.0",
  "description": "Canonical Website-Bot to SEO-Bot handoff and acknowledgement contracts",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
